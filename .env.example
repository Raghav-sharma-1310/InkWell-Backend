# ─────────────────────────────────────────────────────────────────────────────
# Inkwell — EC2 Production Environment Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env on your EC2 host:   cp .env.example .env
# Then replace every CHANGE_ME placeholder with real values.
# Never commit the .env file — it contains production secrets.

# ─── Docker Image Settings ────────────────────────────────────────────────
# Docker Hub: yourusername/inkwell  |  ECR: 123456.dkr.ecr.region.amazonaws.com/inkwell
DOCKER_IMAGE_PREFIX=CHANGE_ME
IMAGE_TAG=latest

# ─── Public URLs (EC2 Public IP / Domain) ─────────────────────────────────
# Use your EC2 public IP, Elastic IP, or custom domain name.
# These are the ONLY places the external IP/domain should appear.
# Internal Docker service-to-service communication uses Docker service names.
FRONTEND_URL=http://CHANGE_ME_EC2_PUBLIC_IP
PUBLIC_GATEWAY_URL=http://CHANGE_ME_EC2_PUBLIC_IP:8080
MEDIA_PUBLIC_BASE_URL=http://CHANGE_ME_EC2_PUBLIC_IP:8080/api/media/public/files

# OAuth2 — frontend redirect URI after successful OAuth login
OAUTH2_REDIRECT_URI=http://CHANGE_ME_EC2_PUBLIC_IP/oauth/success

# Vite build-time variable — "/" means same-origin (Nginx proxies /api to gateway)
VITE_API_BASE_URL=/

# ─── Public Ports ─────────────────────────────────────────────────────────
FRONTEND_HTTP_PORT=80
API_GATEWAY_PORT=8080
ADMIN_SERVER_PORT=9090
DISCOVERY_PORT=8761
RABBITMQ_MANAGEMENT_PORT=15672
MAIL_UI_PORT=8025

# ─── MySQL ────────────────────────────────────────────────────────────────
# Generate strong, unique passwords before deploying.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_APP_USER=inkwell_app
MYSQL_APP_PASSWORD=CHANGE_ME

# ─── JWT ──────────────────────────────────────────────────────────────────
# Must be a long random Base64-encoded string (min 64 chars recommended).
# Must be IDENTICAL across api-gateway and auth-service.
JWT_SECRET=CHANGE_ME

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_USERNAME=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME

# ─── OAuth2 Credentials ──────────────────────────────────────────────────
# Register at https://console.cloud.google.com and https://github.com/settings/developers
# Set authorized redirect URIs to:
#   Google: http://YOUR_EC2_IP:8080/login/oauth2/code/google
#   GitHub: http://YOUR_EC2_IP:8080/login/oauth2/code/github
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME

# ─── Mail ─────────────────────────────────────────────────────────────────
# For EC2 demo with MailHog: MAIL_HOST=mailhog, MAIL_PORT=1025
# For production SMTP: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@inkwell.example
MAIL_FROM_NAME=Inkwell

# ─── Media Storage ────────────────────────────────────────────────────────
# Use "local" with a Docker volume for demos; "s3" for production at scale.
STORAGE_MODE=local
LOCAL_STORAGE_DIR=/app/uploads/media

# S3 (fill these only when STORAGE_MODE=s3)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=

# ─── Razorpay ─────────────────────────────────────────────────────────────
# Leave blank if payment endpoints are disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
